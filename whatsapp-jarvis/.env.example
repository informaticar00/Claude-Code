# Kopiraj u .env (ili upiši u postavke hostinga) i popuni.

# Google Gemini API ključ (besplatan): https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
# Model (neobavezno); zadano gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash

# Telegram bot token: u Telegramu otvori @BotFather -> /newbot -> dobiješ token
TELEGRAM_BOT_TOKEN=
# Samo ovi chat ID-evi smiju razgovarati (zarezom odvojeni). Ostavi prazno = svatko tko nađe bota.
# Bot ti na /start pošalje tvoj chat ID; upiši ga ovdje da bude samo tvoj.
TELEGRAM_ALLOWED_CHAT_IDS=

# Bazni URL servera za webhook. Na Renderu se postavlja sam (RENDER_EXTERNAL_URL),
# pa ovo popuni samo ako hostaš drugdje, npr. https://tvoj-server.com
WEBHOOK_URL=

# Personalizacija (neobavezno)
ASSISTANT_NAME=Jarvis
USER_NAME=
ABOUT_ME=
TZ=Europe/Sarajevo
